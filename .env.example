# 361API / 兼容 OpenAI 中转
# 推荐直接配置这个；如果你历史上用的是 BLTCY_API_KEY，当前代码也兼容。
THREE_SIX_ONE_API_KEY=sk-your-key-here
THREE_SIX_ONE_BASE_URL=https://www.361api.com/v1
HARNESS_DEFAULT_PROVIDER=361api-openai

# 旧环境变量名兼容示例
# BLTCY_API_KEY=sk-your-key-here
# HARNESS_DEFAULT_PROVIDER=my-361api

#    Serper.dev（Google 搜索结果）
#    注册：https://serper.dev  → Dashboard → API Key
#    免费额度：2,500 次/月；端点 POST https://google.serper.dev/search
#    请求头：X-API-KEY: <key>  Content-Type: application/json
SERPER_API_KEY=

# Design image generation / editing tools.
# These variables are used by image_generate and image_edit.
# If DESIGN_IMAGE_API_KEY or DESIGN_IMAGE_BASE_URL are empty, the tools fall
# back to OPENAI_HUB_API_KEY / OPENAI_HUB_BASE_URL when those are configured.
DESIGN_IMAGE_API_KEY=
DESIGN_IMAGE_BASE_URL=https://api.openai-hub.com/v1
DESIGN_IMAGE_MODEL=gpt-image-2
DESIGN_IMAGE_ENDPOINT=https://api.openai-hub.com/v1/images/generations
DESIGN_IMAGE_EDIT_ENDPOINT=https://api.openai-hub.com/v1/images/edits

# Optional image-tool settings.
# DESIGN_IMAGE_BACKEND=codex
# DESIGN_IMAGE_DEFAULT_SIZE=1024x1024
# OPENAI_HUB_IMAGE_MODEL=gpt-image-2
