{\n  \"runId\": \"zhujiajiao-merchandise-system\",\n  \"mode\": \"extension\",\n  \"design_system_ref\": \"plan/design_system.json\",\n  \"target_audience\": {\n    \"primary\": \"古镇游客与文化消费人群\",\n    \"secondary\": \"双语旅游传播与文化赠礼受众\",\n    \"tone_keywords\": [\"地域文化感\", \"收藏感\", \"年轻传播性\", \"文化传承\", \"休闲旅游\"]\n  },\n  \"design_intent\": \"以上海朱家角古镇既有官方身份为上位识别，在不替换官方标识的前提下，提炼桥、船、巷、水纹与昼夜游线，建立一套适用于旅游零售与文化赠礼的 merchandise extension system。系统需同时传达‘地域文化感、收藏感、年轻传播性’，并以‘历史遗存保护、文化传承弘扬、休闲旅游体验一体化’作为信任锚点，明确避开官方现有大清邮局商品的复古邮政语言。\",\n  \"visual_direction\": {\n    \"style_axis\": [\"rational-tech\", \"academic\", \"warm-humanistic\", \"experimental-futurist\"],\n    \"selected_axis\": \"warm-humanistic\",\n    \"palette_strategy\": \"仅使用 design_system.palette.tokens：river-jade、stone-ink、wall-paper、lantern-gold、wood-brown、tile-mist、ginkgo-ochre。\",\n    \"typography_strategy\": \"仅使用 design_system.typography.roles：display、headline、subhead、body、caption、mono。\",\n    \"motif_strategy\": \"统一使用 design_system.motif_system.name = bridge-water-route。\"\n  },\n  \"copywriting_strategy\": {\n    \"languages\": [\"zh\", \"en\"],\n    \"headline_principles\": \"采用 warm-conversational + cultural-tourism + collected 语气，结合‘文化传承’与‘休闲旅游’行为信号，标题短、可收集、可纪念，避免营销夸张与邮政复古腔。\",\n    \"voice_ref\": \"design_system.voice\",\n    \"on_image_text_notes\": \"01用‘上海朱家角古镇 / Zhujiajiao Ancient Town, Shanghai / 水乡慢行系列’；02用‘水乡慢行系列 / Walk the Water Lanes’；03用‘桥名收集系列 / Collect the Bridges’；04用‘昼夜游线礼盒 / Day & Night Route Gift Set’；05用‘帆布袋应用 / Tote Application’；06用‘珐琅徽章组 / Enamel Badge Set’；07用‘旅行贴纸 / Travel Sticker Sheet’；08用‘明信片套组 / Postcard Series’；09用‘礼盒包装展开 / Gift Box System’；10用‘门店陈列海报 / Retail Display’；11用‘系统情绪板 / Visual Moodboard’。所有文案直接烘焙进PNG。\"\n  },\n  \"deliverables\": [\n    {\"id\": \"01-logo-application-poster\", \"file\": \"artifacts/generated-images/01-logo-application-poster.png\", \"purpose\": \"官方标识与新商品系统共存的品牌应用海报\", \"acceptance_test\": \"official-logo 清晰露出且未被改绘；画面采用 river-jade、stone-ink、wall-paper；标题使用 display/caption 形成中英双语品牌署名。\", \"method\": \"image_edit\", \"reference_asset_ids\": [\"official-logo\", \"hero-home-show2\"], \"required_tokens\": [\"river-jade\", \"stone-ink\", \"wall-paper\"], \"required_roles\": [\"display\", \"caption\"]},\n    {\"id\": \"02-campaign-poster-zh\", \"file\": \"artifacts/generated-images/02-campaign-poster-zh.png\", \"purpose\": \"中文主视觉海报，定义桥-船-巷商品系列主题\", \"acceptance_test\": \"中文标题‘水乡慢行系列’ baked in；使用 bridge-water-route 母题；颜色以 river-jade、lantern-gold、wall-paper 为主。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"river-jade\", \"lantern-gold\", \"wall-paper\"], \"required_roles\": [\"display\", \"headline\"]},\n    {\"id\": \"03-campaign-poster-en\", \"file\": \"artifacts/generated-images/03-campaign-poster-en.png\", \"purpose\": \"英文辅助海报，服务国际游客与双语传播\", \"acceptance_test\": \"英文标题‘Collect the Bridges’ baked in；版式与02同系统但非简单翻译复制；使用 stone-ink、wall-paper、ginkgo-ochre。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"stone-ink\", \"wall-paper\", \"ginkgo-ochre\"], \"required_roles\": [\"display\", \"caption\"]},\n    {\"id\": \"04-social-card-announce\", \"file\": \"artifacts/generated-images/04-social-card-announce.png\", \"purpose\": \"昼夜游线礼盒宣传方卡\", \"acceptance_test\": \"方形构图清晰展示‘昼夜游线礼盒 / Day & Night Route Gift Set’；用 river-jade、lantern-gold、tile-mist 表达昼夜对照。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"river-jade\", \"lantern-gold\", \"tile-mist\"], \"required_roles\": [\"headline\", \"subhead\", \"caption\"]},\n    {\"id\": \"05-social-card-portrait\", \"file\": \"artifacts/generated-images/05-social-card-portrait.png\", \"purpose\": \"帆布袋应用展示图，适合零售传播\", \"acceptance_test\": \"基于 tote 商品应用逻辑但不复刻大清邮局图案；可见桥拱与水纹插画；采用 wall-paper、stone-ink、wood-brown。\", \"method\": \"image_edit\", \"reference_asset_ids\": [\"cultural-post-office-tote\"], \"required_tokens\": [\"wall-paper\", \"stone-ink\", \"wood-brown\"], \"required_roles\": [\"headline\", \"caption\"]},\n    {\"id\": \"06-social-card-call\", \"file\": \"artifacts/generated-images/06-social-card-call.png\", \"purpose\": \"徽章组概念图，突出桥名收集玩法\", \"acceptance_test\": \"展示一组可收集徽章/胸针而非单枚；包含 bridge-name seal labels 语言；使用 lantern-gold、stone-ink、wall-paper。\", \"method\": \"image_edit\", \"reference_asset_ids\": [\"cultural-post-office-badge\"], \"required_tokens\": [\"lantern-gold\", \"stone-ink\", \"wall-paper\"], \"required_roles\": [\"headline\", \"mono\", \"caption\"]},\n    {\"id\": \"07-merch-mockup\", \"file\": \"artifacts/generated-images/07-merch-mockup.png\", \"purpose\": \"旅行贴纸与票签套组概念图\", \"acceptance_test\": \"展示多枚贴纸/票签并带系列编号；禁止出现邮票或邮戳复古邮局语义；使用 river-jade、ginkgo-ochre、wall-paper。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"river-jade\", \"ginkgo-ochre\", \"wall-paper\"], \"required_roles\": [\"headline\", \"mono\"]},\n    {\"id\": \"08-signage-mockup\", \"file\": \"artifacts/generated-images/08-signage-mockup.png\", \"purpose\": \"明信片套组或小幅装饰画陈列图\", \"acceptance_test\": \"基于官方桥/船/巷景信息做插画化明信片系列；至少三张并列；使用 tile-mist、stone-ink、lantern-gold。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"tile-mist\", \"stone-ink\", \"lantern-gold\"], \"required_roles\": [\"headline\", \"caption\"]},\n    {\"id\": \"09-moodboard\", \"file\": \"artifacts/generated-images/09-moodboard.png\", \"purpose\": \"礼盒包装系统展开图，展示包装前后与腰封规则\", \"acceptance_test\": \"能看出 packaging-front-panel 结构、bridge-water-route 连续纹样与双语信息层；使用 river-jade、wall-paper、wood-brown。\", \"method\": \"image_generate\", \"reference_asset_ids\": [], \"required_tokens\": [\"river-jade\", \"wall-paper\", \"wood-brown\"], \"required_roles\": [\"headline\", \"subhead\", \"body\"]},\n    {\"id\": \"10-application-on-campus\", \"file\": \"artifacts/generated-images/10-application-on-campus.png\", \"purpose\": \"门店陈列海报或景区零售触点效果图\", \"acceptance_test\": \"基于官方古镇场景做店内或景区陈列合成；体现旅游零售环境；使用 official-logo 或景区名署名，采用 river-jade、lantern-gold、stone-ink。\", \"method\": \"image_edit