{\n  \"runId\": \"zhujiajiao-merchandise-system\",\n  \"mode\": \"extension\",\n  \"system_thesis\": \"以上海朱家角古镇既有官方身份为上位识别，在不替换官方标识的前提下，提炼桥、船、巷、水纹与昼夜游线，建立一套适用于旅游零售与文化赠礼的 merchandise extension system。系统需同时传达‘地域文化感、收藏感、年轻传播性’，并以官方概况页所述‘历史遗存保护、文化传承弘扬、休闲旅游体验一体化’作为信任锚点。视觉延展必须避开官方现有大清邮局商品的复古邮政语言，转向更具朱家角地名、桥名与场景识别的当代国潮插画系统。\",\n  \"derived_from\": {\n    \"reference\": null,\n    \"sources\": [\n      \"research/evidence.json\",\n      \"research/brand_lock.md\",\n      \"research/assets/manifest.json\",\n      \"research/assets/validation.json\"\n    ]\n  },\n  \"palette\": {\n    \"strategy\": \"从白墙灰瓦、河水青绿、木船褐色、夜游暖金与银杏秋黄中提炼低饱和但适合文创零售的色彩系统。\",\n    \"tokens\": [\n      {\"name\": \"river-jade\", \"hex\": \"#4F7C74\", \"role\": \"primary\", \"usage\": \"主视觉青绿、水道底色、礼盒大面积色块\"},\n      {\"name\": \"stone-ink\", \"hex\": \"#2F3A3D\", \"role\": \"ink\", \"usage\": \"标题、线稿、深底、桥轮廓与导视信息\"},\n      {\"name\": \"wall-paper\", \"hex\": \"#F2EBDD\", \"role\": \"paper\", \"usage\": \"白墙感浅底、包装留白、纸品主底\"},\n      {\"name\": \"lantern-gold\", \"hex\": \"#D8A14A\", \"role\": \"accent\", \"usage\": \"夜游暖光、徽章边、限定标签、高光点缀\"},\n      {\"name\": \"wood-brown\", \"hex\": \"#8A5A3C\", \"role\": \"support\", \"usage\": \"木船、木构、绳带、包装辅色\"},\n      {\"name\": \"tile-mist\", \"hex\": \"#B8B6AE\", \"role\": \"neutral\", \"usage\": \"灰瓦、中性分区、背景层次\"},\n      {\"name\": \"ginkgo-ochre\", \"hex\": \"#C9A646\", \"role\": \"seasonal\", \"usage\": \"秋季限定、收集系列标签、节庆礼赠点缀\"}\n    ]\n  },\n  \"typography\": {\n    \"strategy\": \"中文标题采用匾额感/碑刻感的高辨识风格，英文采用克制清晰的辅助字，形成旅游零售双语层级。\",\n    \"roles\": {\n      \"display\": \"中文主标题字；用于系列名、礼盒封面、大幅传播语\",\n      \"headline\": \"商品名、中英副标题、包装正面主信息\",\n      \"subhead\": \"桥名、路线名、系列说明、场景副标\",\n      \"body\": \"商品说明、礼盒介绍、双语辅助文案\",\n      \"caption\": \"地点、年份、限定说明、英文小标签\",\n      \"mono\": \"编号、桥名代码、游线序号、收藏系统编码\"\n    }\n  },\n  \"grid\": {\n    \"base_unit\": 8,\n    \"principle\": \"以海报式竖版、方卡、横向包装展示与陈列板为基础版式，保持明显留白与路径型视觉流线。\",\n    \"layouts\": [\"poster-portrait\", \"square-card\", \"landscape-banner\", \"packaging-front-panel\"]\n  },\n  \"motif_system\": {\n    \"name\": \"bridge-water-route\",\n    \"description\": \"将放生桥拱形、河道曲线、船桨水纹、石板巷纵深与桥名印章整合成连续图形语言，用于包装、贴纸、徽章、帆布袋、明信片与礼盒腰封。\",\n    \"components\": [\n      \"bridge arch silhouette\",\n      \"curved canal ribbon\",\n      \"oar-stroke stripes\",\n      \"lane perspective blocks\",\n      \"bridge-name seal labels\"\n    ],\n    \"rules\": [\n      \"以插画化重组表达桥船水巷，不直接描摹官网同角度照片。\",\n      \"辅助纹样优先使用桥拱、水纹、路线编号与桥名标签，不使用邮戳票据复古邮政符号。\",\n      \"每个商品应用至少出现一种主母题与一种编号/标签语言。\"\n    ]\n  },\n  \"voice\": {\n    \"register\": \"warm-conversational + cultural-tourism + collected\",\n    \"principle_keywords\": [\"地域文化感\", \"收藏感\", \"年轻传播性\", \"文化传承\", \"休闲旅游\", \"双语导览\"],\n    \"do_say\": [\n      \"在桥与水之间，把朱家角带回家。\",\n      \"Collect the bridges, boats and lanes of Zhujiajiao.\",\n      \"慢行古镇，带走一段水乡记忆。\"\n    ],\n    \"do_not_say\": [\n      \"颠覆性国潮爆款\",\n      \"最潮最炸最出片\",\n      \"帝国邮局复刻典藏\",\n      \"Generic Jiangnan souvenir\"\n    ]\n  },\n  \"lockup\": {\n    \"string_zh\": \"上海朱家角古镇\",\n    \"string_en\": \"Zhujiajiao Ancient Town, Shanghai\",\n    \"usage\": \"官方组织名称必须按研究证据准确使用；当官方logo出现时仅作为合规署名或品牌来源露出，不可被替换、重绘或伪造。\"\n  },\n  \"imagery_strategy\": {\n    \"approach\": \"以官方桥、船、河巷、夜游、银杏等场景资产为编辑参考，优先进行插画化、版式化、商品化重组；面向游客与文化赠礼人群，兼顾纪念品陈列吸引力与双语可读性。\",\n    \"treatments\": [\n      \"flattened guochao illustration over official scene geometry\",\n      \"collector-label overlays\",\n      \"day-night series contrast\",\n      \"map-like route framing\"\n    ]\n  },\n  \"asset_usage_policy\": {\n    \"rules\": [\n      \"Do not replace any existing official logo. 上海朱家角古镇官方标识 remains the canonical mark.\",\n      \"Use the official organisation name exactly as cited in research/evidence.json and mirror it in lockup.string_zh / lockup.string_en.\",\n      \"Any deliverable using the official mark must route through image_edit with official-logo or official-logo-footer as reference.\",\n      \"Prefer image_edit whenever a relevant reference asset is marked allowed_for_edit=true.\",\n      \"Do not synthesize a competing version of any do_not_replace=true asset.\",\n      \"官方文创页中的大清邮局商品图只能作为避让参考，不可作为同主题复刻蓝本。\"\n    ]\n  },\n  \"do_not_use\": [\n    \"大清邮局复古邮政版式\",\n    \"邮戳票据拼贴风\",\n    \"直接重绘官方logo\",\n    \"官网同角度照片转插画\",\n    \"泛江南古镇红灯笼水墨模板\",\n    \"random gradients\",\n    \"glowing nodes\",\n    \"generic hex/brain/chip motifs\",\n    \"fake Latin text\"\n  ]\n}